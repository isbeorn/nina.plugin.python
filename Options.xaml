<ResourceDictionary
    x:Class="NINA.Plugin.Python.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:wpfbehaviors="clr-namespace:NINA.WPF.Base.Behaviors;assembly=NINA.WPF.Base">

    <Style x:Key="DocTabScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="DocContentPanel" TargetType="{x:Type StackPanel}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Orientation" Value="Vertical" />
    </Style>

    <Style x:Key="DocHeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DocSectionHeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,12,0,5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DocBodyText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DocCodeBorder" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0,4,0,10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DocCodeText" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="LookupDataGridHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="LookupCellText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LookupCodeCellText" BasedOn="{StaticResource LookupCellText}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <Style x:Key="LookupSelectableCellText" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LookupSelectableCodeCellText" BasedOn="{StaticResource LookupSelectableCellText}" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <DataTemplate x:Key="Python Scripting_Options">
        <TabControl>
            <i:Interaction.Behaviors>
                <wpfbehaviors:BubbleScrollEvent />
            </i:Interaction.Behaviors>
            <TabItem Header="Summary">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Python Scripting" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            This plugin adds Python Script, Python Condition, and Python Trigger items to the Advanced Sequencer. They execute Python code inside the N.I.N.A. process through pythonnet, with N.I.N.A. services and mediators injected into the Python scope.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            A script instruction runs when the sequencer reaches the instruction. A condition script runs whenever the sequencer checks that condition and uses the script result to decide whether the set should continue. A trigger predicate runs at configured sequence item boundaries and starts its Triggered Instructions when result is truthy. All Python code is trusted in-process code, not separate external processes and not sandboxed.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each script can be inline or file-backed. File-backed scripts store only an absolute path and read the external UTF-8 Python file when they run or are checked.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Use the setup check first, then use the Instruction, Condition, Trigger, Lookup, and Examples tabs while building sequencer scripts.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Setup Check" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Use this check after installing Python, after changing PYTHONNET_PYDLL or PYTHONNET_VENV, or after updating the plugin. The test resolves the Python DLL, initializes pythonnet if needed, imports sys, and reads the active Python version, executable path, prefix, and base prefix.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Set up default venv creates or reuses %LOCALAPPDATA%\NINA\PythonScripting\.venv, enables pip, and sets PYTHONNET_VENV for the current user. Get Python opens the Python download page when Python is not installed.
                        </TextBlock>
                        <StackPanel Margin="0,2,0,8" Orientation="Horizontal">
                            <Button
                                MinWidth="150"
                                Padding="10,4"
                                Command="{Binding TestPythonSetupCommand}"
                                Content="Test Python setup" />
                            <Button
                                MinWidth="170"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Command="{Binding SetupPythonEnvironmentCommand}"
                                Content="Set up default venv" />
                            <Button
                                MinWidth="150"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Command="{Binding OpenPythonDownloadCommand}"
                                Content="Get Python" />
                        </StackPanel>
                        <TextBox
                            MinHeight="72"
                            MaxHeight="160"
                            Padding="6"
                            AcceptsReturn="True"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            IsReadOnly="True"
                            Text="{Binding PythonSetupStatus, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="What must be installed" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            - 64-bit N.I.N.A. and 64-bit Python must be used together.<LineBreak />
                            - Without PYTHONNET_PYDLL or PYTHONNET_VENV, the plugin searches for Python through the Python launcher and known Python install folders. It uses the Python 3 installation selected by the launcher, or the highest discovered Python 3 install.<LineBreak />
                            - If Python is installed somewhere else, set PYTHONNET_PYDLL to the full path of the Python DLL and restart N.I.N.A.<LineBreak />
                            - To use a virtual environment, set PYTHONNET_VENV to the virtual environment root directory and restart N.I.N.A.<LineBreak />
                            - Python.Runtime.dll is deployed with the plugin. The CPython runtime DLL itself is loaded from your Python installation, not copied into the plugin folder.</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Setup">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Runtime Setup" />
                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Python version and bitness" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The embedded runtime is loaded through pythonnet. Python must match the bitness of N.I.N.A.; for normal N.I.N.A. installations this means 64-bit Python. A 32-bit Python installation cannot be loaded into a 64-bit process.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            A typical user install path uses the installed Python 3 version in the folder and DLL name:
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox Style="{StaticResource DocCodeText}" Text="%LOCALAPPDATA%\Programs\Python\Python3XX\python3XX.dll" />
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Using a custom Python install" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            If Python is installed somewhere else, set the PYTHONNET_PYDLL environment variable to the exact Python DLL path. Use the DLL path, not python.exe.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">PYTHONNET_PYDLL=C:\Path\To\Python3XX\python3XX.dll</TextBox>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Restart N.I.N.A. after changing the environment variable. The Python runtime DLL is resolved only before the embedded interpreter is initialized.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Using a virtual environment" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Set PYTHONNET_VENV to the virtual environment root directory, not Scripts\python.exe. The plugin reads pyvenv.cfg, uses the venv executable as the embedded program name, and loads the CPython DLL from the base Python installation recorded by the venv.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">PYTHONNET_VENV=C:\Path\To\.venv</TextBox>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Run the setup test after restarting N.I.N.A. A venv is active when the reported Python prefix points to the venv and the Python base prefix points to the base Python installation.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Python packages" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Packages imported by scripts come from the selected Python installation or virtual environment. Install packages into that same environment before starting N.I.N.A.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">C:\Path\To\.venv\Scripts\python.exe -m pip install package-name</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Deployment files" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The plugin deploys its own assembly, configuration files, dependency metadata, and Python.Runtime.dll to the local N.I.N.A. plugin folder. The real CPython DLL remains part of the Python installation and is selected through the default path, PYTHONNET_PYDLL, or the base Python installation recorded by PYTHONNET_VENV.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="When to use the setup test" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Run the setup test after installing Python, after changing PYTHONNET_PYDLL or PYTHONNET_VENV, after replacing Python.Runtime.dll, or when a Python sequencer item fails before your script code starts. A successful test does not validate camera, telescope, focuser, or other equipment state; it only validates the embedded Python runtime.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="How It Runs">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Execution Model" />
                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="One embedded Python runtime" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The first script or setup test initializes the embedded Python runtime. The runtime stays initialized until the N.I.N.A. process exits. This avoids repeated CPython initialization and shutdown, which is not reliable for in-process embedding.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The selected Python installation or virtual environment is process-wide. Change PYTHONNET_PYDLL or PYTHONNET_VENV before the first setup test or script run, then restart N.I.N.A. to switch environments.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each Python Script instruction execution creates a fresh Python scope. Variables created inside one script are not intentionally injected into the next script scope. Imported Python modules are still normal Python modules, so module-level state can persist for the lifetime of the interpreter.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each Python Condition check also creates a fresh Python scope, executes the condition script, and reads the variable named result. The condition uses normal Python truthiness for result.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each Python Trigger predicate evaluation creates a fresh Python scope, executes the trigger script, and reads the variable named result. If result is truthy, N.I.N.A. runs the trigger's Triggered Instructions through the normal sequencer trigger runner.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Inline and file-backed scripts" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each Python sequencer entity has a source selector. Inline mode stores and executes the editor text. File mode stores only an absolute file path and reads the file as UTF-8 when the entity executes or is checked. The file contents are not copied into the sequence.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            File mode requires a fully qualified path such as C:\Scripts\script.py or \\server\share\script.py. Relative paths, environment variables, and path shortcuts such as %USERPROFILE%, $env:USERPROFILE, and ~ are rejected. Validation checks only the path string; it does not check whether the file, drive, or network share exists.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The dots button follows the selected source mode. In Inline mode it imports a file into the inline editor. In File mode it selects the external script path. File mode preview is read only and refreshes only when the refresh button is clicked. Execution always reads the file again and does not use preview text.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            File-backed scripts receive __file__ with the resolved absolute path. Inline scripts do not receive __file__. File-backed condition and trigger predicate scripts are read every check, so keep those files local, small, and fast; an unavailable network path can delay the sequence while the check is running.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Threading and the GIL" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Script execution is serialized through the Python global interpreter lock. The plugin runs the script while holding the GIL and releases it afterward. Do not create long-running background Python threads unless you understand pythonnet embedding and N.I.N.A. shutdown behavior.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text=".NET objects in Python" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Injected values such as camera, telescope, imaging, sequence, profileService, and optionsVM are live .NET objects. Calling a method from Python is calling that .NET object directly inside N.I.N.A. Exceptions from .NET or Python propagate back to the sequence item and cause the instruction or condition to fail.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Symbol broker values and functions" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each script scope receives a read-only snapshot of current N.I.N.A. symbol broker values and functions. Values are available through the symbols mapping and through direct read-only variables named with sanitized Category_Key names, for example NINA_MoonAltitude or Image_HFR. Functions are available through the symbolFunctions mapping and through direct read-only callables named with sanitized Category_Key names, for example Time_Now() or Math_Round(value, digits). Function arguments are evaluated by Python before the symbol function is invoked. Assigning to one of these names raises a Python syntax error before the script runs.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">moon_altitude = NINA_MoonAltitude
hfr = symbols["Image_HFR"] if "Image_HFR" in symbols else None
rounded = Math_Round(moon_altitude, 2)
now_seconds = symbolFunctions["Time_Now"]()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Async methods" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Many N.I.N.A. APIs return .NET Task objects. In a script, wait for those tasks before depending on the result. The simplest pattern is .Wait(). If you need result values from a generic Task, use the .NET task API exposed by pythonnet.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera.Connect().Wait()
imaging.CaptureAndPrepareImage(captureSequence, prepareImageParameters, token, progress).Wait()
camera.Disconnect().Wait()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Cancellation" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The instruction injects the current CancellationToken as token. Long scripts should check token regularly. N.I.N.A. APIs that accept the token can also observe sequence cancellation.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Conditions and trigger predicates do not receive progress or token because the sequencer calls these checks synchronously. Keep that logic short and avoid waits that would need cancellation. Triggered Instructions do receive their normal sequencer progress and cancellation handling.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">token.ThrowIfCancellationRequested()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Safety" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Scripts are trusted code. They can call N.I.N.A. services, equipment mediators, Python packages, and .NET APIs available to pythonnet. Review scripts carefully before running them, especially scripts that move equipment, save files, change profiles, or call external packages.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Instruction">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Using The Python Script Instruction" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Add the Python Script instruction to the Advanced Sequencer from the Python Scripting category. The instruction contains a Python code editor. When the sequence reaches the item, the editor contents are executed as one Python script.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            In File source mode, the instruction reads the selected absolute file path when the instruction starts. The file path is the source of truth; the preview is only a read-only view loaded on demand.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Use the Condition tab for Python Condition behavior and the Trigger tab for Python Trigger behavior.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="What happens when the item starts" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            - The embedded Python runtime is initialized if this is the first Python use in the current N.I.N.A. process.<LineBreak />
                            - A fresh Python scope is created for the instruction run.<LineBreak />
                            - N.I.N.A. services, mediators, helper objects, progress, token, and helper .NET types are injected into that scope.<LineBreak />
                            - The script text is executed.<LineBreak />
                            - The Python scope is disposed after execution, even when the script throws.<LineBreak />
                            - If the script throws, the sequencer treats the instruction as failed.</TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Default script" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            New instructions start with a minimal camera capture example. It connects the camera, sets the exposure duration on the injected captureSequence object, runs imaging.CaptureAndPrepareImage, and disconnects the camera.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera.Connect().Wait()

captureSequence.ExposureTime = 5.0

imaging.CaptureAndPrepareImage(captureSequence, prepareImageParameters, token, progress).Wait()

camera.Disconnect().Wait()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Editing guidance" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Keep scripts small and explicit. Prefer calling existing N.I.N.A. services over duplicating device logic in Python. If a script grows large, put reusable Python code in a module installed on the selected Python path, then import it from the instruction script.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Failure behavior" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            A Python syntax error, Python exception, .NET exception, failed Task, missing Python DLL, or missing Python package will fail the instruction. Use the setup test for runtime problems and then simplify the script until the failing call is isolated.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Condition">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Using The Python Condition" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Add the Python Condition to an Advanced Sequencer condition set from the Python Scripting category. The condition contains a Python code editor. The script must assign a variable named result before it finishes.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            In sequential containers, N.I.N.A. checks enabled conditions while selecting each next item, including after an item completes, and again after the block finishes to decide whether to reset and repeat. Parent container conditions are checked as part of the same decision. Keep the script fast. Avoid sleeps, long device calls, captures, equipment movement, network calls, or loops that wait for state changes.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            In File source mode, the condition reads the selected absolute file path every time the condition is checked. Use a local file for frequently checked conditions; an unavailable network path can delay the sequence during the check.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="What happens when the condition is checked" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            - The embedded Python runtime is initialized if this is the first Python use in the current N.I.N.A. process.<LineBreak />
                            - A fresh Python scope is created for this check.<LineBreak />
                            - The check is triggered by the sequential execution strategy while selecting the next item, after each item completes, and after the block finishes to decide whether to repeat.<LineBreak />
                            - The same N.I.N.A. services and mediators used by the instruction are injected into that scope.<LineBreak />
                            - Condition context values previousItem, nextItem, parent, and condition are injected.<LineBreak />
                            - Common helper .NET types such as TimeSpan, Guid, Coordinates, TopocentricCoordinates, SiderealShiftTrackingRate, and FilterInfo are injected.<LineBreak />
                            - The script text is executed.<LineBreak />
                            - The variable result is read with normal Python truthiness.<LineBreak />
                            - If the script throws or does not assign result, the condition fails and evaluates false.</TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Default script" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            New conditions start as always true. Replace the assignment with a fast expression that reads current N.I.N.A. state.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}"># In sequential containers, N.I.N.A. checks this while selecting each next item,
# including after an item completes, and after the block finishes to decide repeat.
# Keep it fast. Truthy result keeps the loop running; falsey stops it.
result = True</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Condition context" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            previousItem and nextItem are the neighboring sequence items passed to the condition check and can be None. parent is the owning sequence container and can be None before the condition is attached. condition is the Python Condition object itself.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}"># Continue only when this condition is attached to a sequence container.
result = parent is not None</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Fast equipment-state example" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Reading a mediator info object is appropriate for a condition. Starting a capture, slew, autofocus run, or other long operation is not.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera_info = camera.GetInfo()
result = camera_info.Connected</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Profile-state example" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The active profile is available as profile. Use it for quick reads of configured state, and avoid changing profile settings while a sequence is running unless the script is intentionally doing that.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}"># Replace this with the profile field you need to inspect.
result = profile is not None</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Failure behavior" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            A syntax error, Python exception, .NET exception, failed Python runtime setup, or missing result variable causes the condition to fail. The sequencer catches the failure, marks the condition failed, raises the normal failure event, and treats the condition check as false.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Trigger">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Using The Python Trigger" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Add the Python Trigger to an Advanced Sequencer trigger set from the Python Scripting category. The trigger has a Python predicate script, a timing selector, and a Triggered Instructions area. The predicate must assign a variable named result before it finishes.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The Python script is only the decision point. It should quickly inspect current state and return true or false. Put captures, slews, autofocus, waits, device changes, and other real work in Triggered Instructions. Those instructions are run by N.I.N.A.'s normal trigger runner when result is truthy.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            In File source mode, the trigger reads the selected absolute file path every time the predicate is checked. Use a local file for frequently checked trigger predicates; an unavailable network path can delay the sequence during the check.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="When the predicate is checked" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            In sequential containers, N.I.N.A. evaluates triggers before each next sequence item starts. It also supports an after-item trigger pass after an item completes and the following item has been determined, before that following item starts. The Python Trigger timing selector chooses whether this predicate is evaluated before the next item, after the completed item, or in both passes.
                        </TextBlock>
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The same trigger evaluation cascade used by N.I.N.A. applies: triggers on the active container are evaluated, then triggers on parent containers are evaluated. Keep the predicate fast because it can be checked many times during a sequence.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="What happens when the trigger is checked" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            - The embedded Python runtime is initialized if this is the first Python use in the current N.I.N.A. process.<LineBreak />
                            - A fresh Python scope is created for this predicate evaluation.<LineBreak />
                            - The same N.I.N.A. services and mediators used by instruction and condition scripts are injected into that scope.<LineBreak />
                            - Trigger context values phase, previousItem, nextItem, parent, trigger, triggerRunner, and state are injected.<LineBreak />
                            - Common helper .NET types such as TimeSpan, Guid, Coordinates, TopocentricCoordinates, SiderealShiftTrackingRate, and FilterInfo are injected.<LineBreak />
                            - The script text is executed.<LineBreak />
                            - The variable result is read with normal Python truthiness.<LineBreak />
                            - If result is truthy, N.I.N.A. executes the configured Triggered Instructions.</TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Default script" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            New triggers start with result = False. Change result to a fast expression that decides whether Triggered Instructions should run.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}"># N.I.N.A. checks this at sequence item boundaries.
# phase is "before" before nextItem starts, or "after" after previousItem completes.
# Keep this predicate fast. Put long work in Triggered Instructions.
# Set result truthy to run the triggered instructions.
result = False</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Trigger context" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            phase is the string "before" or "after". previousItem is the item that just ran and can be None. nextItem is the item about to run and can be None. parent is the owning sequence container. trigger is the Python Trigger object. triggerRunner is the container that holds Triggered Instructions. state is a per-trigger dictionary that is reset when the sequence block initializes.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}"># Fire only during the before-item pass.
result = phase == "before" and nextItem is not None</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Counter example" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Use state for small predicate state that should survive between trigger checks in the same sequence block. Do not use it to hold device objects, tasks, Python threads, or large data.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">count = state["count"] if state.ContainsKey("count") else 0
count = count + 1
state["count"] = count

# Run Triggered Instructions every third before-item check.
result = phase == "before" and count % 3 == 0</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Equipment-state example" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Reading mediator info is appropriate for a trigger predicate. Starting long-running work is not. Add that work as a normal instruction under Triggered Instructions.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera_info = camera.GetInfo()
result = phase == "before" and camera_info.Connected</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Failure behavior" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            A syntax error, Python exception, .NET exception, failed Python runtime setup, or missing result variable prevents the predicate from returning true. If the predicate returns true and a Triggered Instruction fails, the trigger run follows N.I.N.A.'s normal trigger failure handling.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lookup">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Interface Lookup" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Use this table while writing instruction, condition, or trigger scripts. It maps Python variable names to the injected .NET interfaces, helper types, symbol snapshot mappings, instruction helpers, condition context values, trigger context values, and file-mode context values. The filter searches the Python name, interface/type, category, and description. Select a row to show the available members and Python usage directly below it.
                        </TextBlock>
                        <TextBox
                            MinWidth="260"
                            Margin="0,2,0,8"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Stretch"
                            Text="{Binding InterfaceLookupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Filter by Python name, interface, category, or description" />
                        <DataGrid
                            MinHeight="360"
                            AutoGenerateColumns="False"
                            BorderBrush="{DynamicResource BorderBrush}"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            ClipboardCopyMode="IncludeHeader"
                            ColumnHeaderStyle="{StaticResource LookupDataGridHeader}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                            IsReadOnly="True"
                            ItemsSource="{Binding InterfaceLookup}"
                            RowDetailsVisibilityMode="VisibleWhenSelected"
                            SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="155"
                                    ClipboardContentBinding="{Binding PythonName}"
                                    Header="Python name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Style="{StaticResource LookupSelectableCellText}"
                                                Text="{Binding PythonName, Mode=OneWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="260"
                                    ClipboardContentBinding="{Binding DotNetType}"
                                    Header="Interface / type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Style="{StaticResource LookupSelectableCellText}"
                                                Text="{Binding DotNetType, Mode=OneWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="130"
                                    ClipboardContentBinding="{Binding Category}"
                                    Header="Category">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Style="{StaticResource LookupSelectableCellText}"
                                                Text="{Binding Category, Mode=OneWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="360"
                                    ClipboardContentBinding="{Binding Description}"
                                    Header="Description">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Style="{StaticResource LookupSelectableCellText}"
                                                Text="{Binding Description, Mode=OneWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="24,2,0,10"
                                        Padding="10"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                                            <TextBlock
                                                Style="{StaticResource DocSectionHeadingText}"
                                                Text="{Binding PythonName, StringFormat=Members for {0}}" />
                                            <TextBlock
                                                Style="{StaticResource DocBodyText}"
                                                Text="{Binding Description}" />
                                            <TextBlock
                                                Style="{StaticResource DocBodyText}"
                                                Text="{Binding DotNetType, StringFormat=Interface / type: {0}}" />
                                            <DataGrid
                                                MinHeight="120"
                                                AutoGenerateColumns="False"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                CanUserAddRows="False"
                                                CanUserDeleteRows="False"
                                                ClipboardCopyMode="IncludeHeader"
                                                ColumnHeaderStyle="{StaticResource LookupDataGridHeader}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                GridLinesVisibility="Horizontal"
                                                HeadersVisibility="Column"
                                                HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding Members}"
                                                SelectionMode="Extended"
                                                SelectionUnit="CellOrRowHeader">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn
                                                        Width="90"
                                                        ClipboardContentBinding="{Binding Kind}"
                                                        Header="Kind">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox
                                                                    Style="{StaticResource LookupSelectableCellText}"
                                                                    Text="{Binding Kind, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="330"
                                                        ClipboardContentBinding="{Binding Signature}"
                                                        Header="Signature">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox
                                                                    Style="{StaticResource LookupSelectableCodeCellText}"
                                                                    Text="{Binding Signature, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="260"
                                                        ClipboardContentBinding="{Binding Usage}"
                                                        Header="Python usage">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox
                                                                    Style="{StaticResource LookupSelectableCodeCellText}"
                                                                    Text="{Binding Usage, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn
                                                        Width="420"
                                                        ClipboardContentBinding="{Binding Annotation}"
                                                        Header="Annotation">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox
                                                                    Style="{StaticResource LookupSelectableCellText}"
                                                                    Text="{Binding Annotation, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Examples">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Examples" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            These examples show patterns for the Python Script instruction and short predicates for Python Condition and Python Trigger. They use only objects injected by the relevant sequencer item.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Single camera capture" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            This is the default pattern. It waits for each .NET Task before continuing.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera.Connect().Wait()

captureSequence.ExposureTime = 5.0
imaging.CaptureAndPrepareImage(captureSequence, prepareImageParameters, token, progress).Wait()

camera.Disconnect().Wait()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Cancellation-aware structure" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Check token before and after work that may take time. N.I.N.A. methods that accept token should receive the injected token.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">token.ThrowIfCancellationRequested()

captureSequence.ExposureTime = 10.0
imaging.CaptureAndPrepareImage(captureSequence, prepareImageParameters, token, progress).Wait()

token.ThrowIfCancellationRequested()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Importing Python modules" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Imports use the selected Python installation or virtual environment. If the import fails, install the package into that environment before starting N.I.N.A.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">import math

angle_radians = math.radians(45.0)
value = math.sin(angle_radians)</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Using N.I.N.A. symbols" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Symbol broker values and functions are captured when the script scope is created. Use direct read-only Category_Key variables and callables for symbols and functions that are expected to exist, or use the symbols and symbolFunctions mappings when an entry may not be available yet.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">moon_altitude = NINA_MoonAltitude
rounded_moon_altitude = Math_Round(moon_altitude, 2)

if "Image_HFR" in symbols:
    last_hfr = symbols["Image_HFR"]
else:
    last_hfr = None

now_seconds = symbolFunctions["Time_Now"]()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Creating helper .NET values" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Some common .NET types are injected so scripts can create values without importing their CLR namespaces.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">delay = TimeSpan.FromSeconds(5)
run_id = Guid.NewGuid()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Using the file-backed script path" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            __file__ is available only when the entity is in File source mode. Use it to resolve sibling files from the external script location.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">from pathlib import Path

script_dir = Path(__file__).parent
config_path = script_dir / "settings.json"</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Use explicit error handling where useful" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            If cleanup must happen after a failed call, use normal Python try/finally. Exceptions still propagate after finally unless you catch and suppress them.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">camera.Connect().Wait()
try:
    captureSequence.ExposureTime = 5.0
    imaging.CaptureAndPrepareImage(captureSequence, prepareImageParameters, token, progress).Wait()
finally:
    camera.Disconnect().Wait()</TextBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Trigger predicate using state" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            This belongs in a Python Trigger predicate. Put the actual action into Triggered Instructions.
                        </TextBlock>
                        <Border Style="{StaticResource DocCodeBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBox xml:space="preserve" Style="{StaticResource DocCodeText}">count = state["count"] if state.ContainsKey("count") else 0
count = count + 1
state["count"] = count

result = phase == "before" and count % 5 == 0</TextBox>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Troubleshooting">
                <ScrollViewer Style="{StaticResource DocTabScrollViewer}">
                    <StackPanel Style="{StaticResource DocContentPanel}">
                        <TextBlock Style="{StaticResource DocHeadingText}" Text="Troubleshooting" />

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="The setup test fails before showing a Python version" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Check that the Python DLL exists and matches N.I.N.A. bitness. If Python discovery does not find the install you want, set PYTHONNET_PYDLL to the exact Python DLL path or set PYTHONNET_VENV to a venv root directory and restart N.I.N.A.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="ImportError or ModuleNotFoundError" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The package is not installed in the selected Python environment, or Python is using a different environment than expected. Run the setup test and verify the reported Python executable, prefix, and base prefix. Install packages into that environment.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="A file-backed script fails to read" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            File mode stores only the absolute path. If the file is moved, deleted, locked, or on an unavailable drive or network share, the instruction, condition, or trigger fails when it tries to read the file. Validation does not check file existence because that can block on unavailable network paths.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="The script runs once but not again" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Each instruction run, condition check, and trigger predicate check gets a new script scope, but Python modules stay loaded in the interpreter. Avoid relying on accidental module-level state. If a module caches device objects or starts background work, make sure it has explicit cleanup.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="N.I.N.A. becomes unresponsive while the script runs" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The script is executing inside the N.I.N.A. process. Long CPU-bound Python loops, blocking waits, or device calls that never return will block the sequence item. Keep instruction scripts short, check token in instructions, and keep condition and trigger predicate scripts especially fast because sequential containers check them at sequence item boundaries.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Application shutdown after using Python" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The plugin does not call PythonEngine.Shutdown during N.I.N.A. shutdown because embedded CPython finalization can block the application shutdown path. The interpreter is left initialized and the process exit reclaims it.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="A .NET method call is not recognized" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            Remember that injected objects are .NET interfaces and services. Use the method names and signatures from the N.I.N.A. API surface for the object you are calling. If a method returns a Task, wait for it before continuing.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocSectionHeadingText}" Text="Syntax highlighting works but colors look wrong" />
                        <TextBlock Style="{StaticResource DocBodyText}">
                            The editor uses N.I.N.A. application brushes for its surface, caret, selection, line numbers, and foreground. If the application color profile changes while the options page is already open, close and reopen the plugin options page if AvalonEdit does not repaint all internal editor elements immediately.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DataTemplate>
</ResourceDictionary>
